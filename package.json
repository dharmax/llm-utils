{
  "name": "@dharmax/llm-utils",
  "version": "1.0.0",
  "description": "Small LLM primitives for typed provider execution, structured responses, routing, prompts, context, sessions, and metrics.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "llm": "./bin/cli.ts"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.js --sourcemap --resolve-extensions=.ts,.tsx,.js,.json --external:zod && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.check.json",
    "check": "bun test",
    "test": "bun test",
    "cli": "bun bin/cli.ts",
    "repl": "bun bin/cli.ts"
  },
  "keywords": [
    "llm",
    "ai",
    "routing",
    "prompt-management",
    "session-context"
  ],
  "author": "dharmax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharmax/llm-utils.git"
  },
  "bugs": {
    "url": "https://github.com/dharmax/llm-utils/issues"
  },
  "homepage": "https://github.com/dharmax/llm-utils#readme",
  "dependencies": {
    "@dharmax/pubsub": "file:../pubsub",
    "jsonrepair": "^3.14.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@dharmax/shell-proc-utils": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@dharmax/shell-proc-utils": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dharmax/shell-proc-utils": "file:../shell-proc-utils",
    "@types/bun": "^1.4.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
